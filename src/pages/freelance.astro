---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Freelance Senior-Entwickler | IPC24 e.K."
  description="Erfahrener Full-Stack-Entwickler für anspruchsvolle Projekte — remote oder vor Ort. TypeScript, React, Node.js und mehr."
>
  <section class="section-container py-20 text-center">
    <span class="text-5xl mb-6 block" aria-hidden="true">👤</span>
    <h1 class="text-4xl font-extrabold text-gray-900 mb-4">Freelance-Experte</h1>
    <p class="text-lg text-gray-600 max-w-xl mx-auto">
      Diese Seite ist in Kürze verfügbar. Hier finden Sie bald alle Informationen
      zum Freelance-Profil von IPC24 e.K.
    </p>
    <a href="/" class="btn-primary mt-8 inline-flex">← Zurück zur Startseite</a>
  </section>
</BaseLayout>
